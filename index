<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OvertNexus | Connect With Us</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;

            background:
                radial-gradient(circle at 10% 10%, rgba(241, 91, 42, 0.22), transparent 30%),
                radial-gradient(circle at 90% 90%, rgba(255, 170, 80, 0.18), transparent 30%),
                linear-gradient(135deg, #fff8f4, #ffffff, #fff3ec);

            background-size: 200% 200%;
            animation: backgroundMove 10s ease infinite;

            color: #222;
            display: flex;
            justify-content: center;
            padding: 35px 15px;

            overflow-x: hidden;
        }


        /* =========================
           Animated Background
        ========================= */

        @keyframes backgroundMove {

            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }

        }


        /* =========================
           Main Container
        ========================= */

        .container {
            width: 100%;
            max-width: 460px;
            text-align: center;
            position: relative;
            z-index: 2;
        }


        /* =========================
           Logo
        ========================= */

        .logo-box {

            width: 125px;
            height: 125px;

            background: #ffffff;

            border-radius: 28px;

            margin: 10px auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 15px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.10),
                0 2px 8px rgba(241, 91, 42, 0.15);

            animation:
                logoAppear 1s ease-out,
                floatingLogo 4s ease-in-out infinite 1s;
        }


        .logo-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }


        /* Logo entrance */

        @keyframes logoAppear {

            0% {
                opacity: 0;
                transform: scale(0.5) rotate(-8deg);
            }

            70% {
                transform: scale(1.05) rotate(2deg);
            }

            100% {
                opacity: 1;
                transform: scale(1) rotate(0);
            }

        }


        /* Logo floating */

        @keyframes floatingLogo {

            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }

        }


        /* =========================
           Heading
        ========================= */

        h1 {

            font-size: 28px;
            font-weight: 700;

            margin-bottom: 8px;

            color: #222;

            animation: titleAppear 1s ease-out 0.3s both;
        }


        .subtitle {

            font-size: 15px;
            color: #777;

            margin-bottom: 28px;

            animation: titleAppear 1s ease-out 0.5s both;
        }


        @keyframes titleAppear {

            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =========================
           Social Buttons
        ========================= */

        .social-link {

            position: relative;

            display: flex;

            align-items: center;
            justify-content: center;

            min-height: 58px;

            margin: 14px 0;

            padding: 15px 20px;

            background: rgba(255, 255, 255, 0.95);

            color: #222;

            text-decoration: none;

            font-size: 16px;

            font-weight: 600;

            border-radius: 14px;

            border: 1px solid rgba(241, 91, 42, 0.12);

            box-shadow:
                0 6px 20px rgba(0, 0, 0, 0.07);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;

            opacity: 0;

            animation: buttonAppear 0.7s ease forwards;
        }


        /* Button entrance */

        .social-link:nth-of-type(1) {
            animation-delay: 0.7s;
        }

        .social-link:nth-of-type(2) {
            animation-delay: 0.9s;
        }

        .social-link:nth-of-type(3) {
            animation-delay: 1.1s;
        }

        .social-link:nth-of-type(4) {
            animation-delay: 1.3s;
        }


        @keyframes buttonAppear {

            from {
                opacity: 0;
                transform: translateY(35px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =========================
           Hover Animation
        ========================= */

        .social-link:hover {

            transform: translateY(-5px) scale(1.02);

            box-shadow:
                0 14px 30px rgba(241, 91, 42, 0.18);

            border-color:
                rgba(241, 91, 42, 0.35);
        }


        /* =========================
           REAL SOCIAL ICONS
        ========================= */

        .icon {

            position: absolute;

            left: 18px;

            width: 32px;
            height: 32px;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 22px;

            transition:
                transform 0.3s ease,
                color 0.3s ease;
        }


        .social-link:hover .icon {

            transform:
                scale(1.2)
                rotate(-8deg);
        }


        /* Instagram */

        .instagram .icon {
            color: #E4405F;
        }


        /* Facebook */

        .facebook .icon {
            color: #1877F2;
        }


        /* LinkedIn */

        .linkedin .icon {
            color: #0A66C2;
        }


        /* Website */

        .website .icon {
            color: white;
        }


        /* =========================
           Website Button
        ========================= */

        .website {

            background:
                linear-gradient(
                    135deg,
                    #f15b2a,
                    #ff7a45
                );

            color: white;

            border: none;

            box-shadow:
                0 8px 20px
                rgba(241, 91, 42, 0.28);

            position: relative;

            overflow: hidden;
        }


        /* Website shine animation */

        .website::after {

            content: "";

            position: absolute;

            top: 0;

            left: -100%;

            width: 60%;

            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255,255,255,0.35),
                    transparent
                );

            transform: skewX(-20deg);

            animation:
                shine 3.5s infinite;
        }


        @keyframes shine {

            0% {
                left: -100%;
            }

            35% {
                left: 130%;
            }

            100% {
                left: 130%;
            }

        }


        .website:hover {

            box-shadow:
                0 14px 32px
                rgba(241, 91, 42, 0.38);

            color: white;
        }


        /* =========================
           Footer
        ========================= */

        .footer {

            margin-top: 30px;

            font-size: 12px;

            color: #999;

            animation:
                titleAppear
                1s ease-out
                1.5s both;
        }


        .footer strong {
            color: #f15b2a;
        }


        /* =========================
           Floating Background Circles
        ========================= */

        .container::before,
        .container::after {

            content: "";

            position: fixed;

            width: 180px;
            height: 180px;

            border-radius: 50%;

            background:
                rgba(241, 91, 42, 0.06);

            z-index: -1;

            animation:
                floatingCircle
                8s ease-in-out infinite;
        }


        .container::before {

            top: 10%;
            left: -80px;
        }


        .container::after {

            bottom: 10%;
            right: -80px;

            animation-delay: 2s;
        }


        @keyframes floatingCircle {

            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-30px);
            }

        }


        /* =========================
           Mobile
        ========================= */

        @media (max-width: 480px) {

            body {
                padding: 25px 15px;
            }

            .logo-box {
                width: 110px;
                height: 110px;
            }

            h1 {
                font-size: 25px;
            }

            .social-link {
                min-height: 56px;
            }

        }


        /* =========================
           Accessibility
        ========================= */

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {

                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;

            }

        }

    </style>
</head>


<body>

<div class="container">


    <!-- OvertNexus Logo -->

    <div class="logo-box">

        <img
            src="logo.png.jpeg"
            alt="OvertNexus Logo">

    </div>


    <!-- Heading -->

    <h1>Overt Nexus</h1>

    <p class="subtitle">
        Connect with us
    </p>


    <!-- Website -->

    <a
        class="social-link website"
        href="https://www.overtnexus.com"
        target="_blank"
        rel="noopener">

        <span class="icon">
            <i class="fa-solid fa-globe"></i>
        </span>

        Overt Nexus Website

    </a>


    <!-- Instagram -->

    <a
        class="social-link instagram"
        href="https://www.instagram.com/overtnexus/"
        target="_blank"
        rel="noopener">

        <span class="icon">
            <i class="fa-brands fa-instagram"></i>
        </span>

        Instagram

    </a>


    <!-- Facebook -->

    <a
        class="social-link facebook"
        href="https://www.facebook.com/overtnexus/"
        target="_blank"
        rel="noopener">

        <span class="icon">
            <i class="fa-brands fa-facebook-f"></i>
        </span>

        Facebook

    </a>


    <!-- LinkedIn -->

    <a
        class="social-link linkedin"
        href="https://www.linkedin.com/company/overtnexus/"
        target="_blank"
        rel="noopener">

        <span class="icon">
            <i class="fa-brands fa-linkedin-in"></i>
        </span>

        LinkedIn

    </a>


    <!-- Footer -->

    <div class="footer">

        © 2026 <strong>OvertNexus</strong>

    </div>


</div>

</body>
</html>
